{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account with role-based access control (default 'member', staff roles assigned by Super Admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 150 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "pengurus_kecamatan", "admin_keanggotaan", "bendahara", "admin_informasi", "pengurus_kelurahan", "member"]
        },
        "kelurahan": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "AdminEmail": {
      "title": "AdminEmail",
      "description": "Server-validated officer email to RBAC role lookup document keyed by lowercase email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "pengurus_kecamatan", "admin_keanggotaan", "bendahara", "admin_informasi", "pengurus_kelurahan", "member"]
        },
        "uid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "uid"]
    },
    "Member": {
      "title": "Member",
      "description": "Registered UMKM member with validated 16-digit NIK, business, and contact profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "memberNumber": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "nik": { "type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[0-9]{16}$" },
        "phone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "kelurahan": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["aktif", "nonaktif", "pending"] },
        "joinDate": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "topProduct": { "type": "string", "maxLength": 150 },
        "businessAddress": { "type": "string", "maxLength": 300 },
        "businessPhone": { "type": "string", "maxLength": 30 },
        "memberPhoto": { "type": "string", "maxLength": 900000 },
        "productPhoto": { "type": "string", "maxLength": 900000 },
        "legalities": { "type": "string", "maxLength": 300 },
        "isPublicDirectory": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberNumber", "fullName", "nik", "phone", "kelurahan", "businessName", "category", "status", "isPublicDirectory"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial cashbook entry for income, expense, and dues.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionNumber": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["pemasukan", "pengeluaran"] },
        "category": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "recorderName": { "type": "string", "maxLength": 150 },
        "recorderId": { "type": "string", "maxLength": 128 },
        "approvalStatus": { "type": "string", "enum": ["disetujui", "menunggu", "ditolak"] },
        "approvedBy": { "type": "string", "maxLength": 150 },
        "memberId": { "type": "string", "maxLength": 128 },
        "memberName": { "type": "string", "maxLength": 150 },
        "memberNumber": { "type": "string", "maxLength": 50 },
        "proofUrl": { "type": "string", "maxLength": 900000 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionNumber", "type", "category", "date", "amount", "description", "approvalStatus"]
    },
    "Event": {
      "title": "Event",
      "description": "Forum event, training, bazaar, or exhibition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 250 },
        "organizer": { "type": "string", "maxLength": 150 },
        "posterUrl": { "type": "string", "maxLength": 900000 },
        "documentationUrls": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["terbit", "draf", "arsip", "selesai"] },
        "targetAudience": { "type": "string", "maxLength": 150 },
        "registrationUrl": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "date", "location", "status"]
    },
    "Article": {
      "title": "Article",
      "description": "News and educational article published by the forum.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "excerpt": { "type": "string", "maxLength": 400 },
        "content": { "type": "string", "maxLength": 10000 },
        "category": { "type": "string", "maxLength": 80 },
        "author": { "type": "string", "maxLength": 150 },
        "authorId": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string", "maxLength": 900000 },
        "publishedDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["terbit", "draf", "arsip"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "category", "author", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of administrative activities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 100 },
        "target": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "action", "target", "timestamp"]
    },
    "OrgStructureMember": {
      "title": "OrgStructureMember",
      "description": "Leadership and officer structure for Forum UMKM KUAT.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "maxLength": 900000 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "name", "order"]
    },
    "OrgContactInfo": {
      "title": "OrgContactInfo",
      "description": "Contact info, address, office hours, and social media links (Instagram, TikTok, YouTube, Facebook).",
      "type": "object",
      "properties": {
        "officeName": { "type": "string", "maxLength": 150 },
        "subTitle": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "operatingHours": { "type": "string", "maxLength": 100 },
        "googleMapsUrl": { "type": "string", "maxLength": 500 },
        "instagram": { "type": "string", "maxLength": 200 },
        "tiktok": { "type": "string", "maxLength": 200 },
        "youtube": { "type": "string", "maxLength": 200 },
        "facebook": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["officeName", "address", "whatsapp", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "System admin users and role profiles."
    },
    "/admin_emails/{emailId}": {
      "schema": { "$ref": "#/entities/AdminEmail" },
      "description": "Authoritative officer email to role index for RBAC."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Admin privilege marker document."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "UMKM member directory and details."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Internal financial transactions and cash flow."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Community events and programs."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "News and educational publications."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Administrative audit trail."
    },
    "/org_structure/{memberId}": {
      "schema": { "$ref": "#/entities/OrgStructureMember" },
      "description": "Official leadership and officer profiles."
    },
    "/org_settings/{settingId}": {
      "schema": { "$ref": "#/entities/OrgContactInfo" },
      "description": "General forum organization configuration including contact info, vision/mission, and social media."
    }
  }
}
