rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    // System Security Rule 1: SUPER ADMIN CONTROL
    function isBootstrapSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'umkmkectangerang@gmail.com' ||
        request.auth.token.email == 'agus.cabin@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@tangerangkota\\.go\\.id$'))
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isBootstrapSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'super_admin')
      );
    }

    // Admin Staff (Pengurus yang berwenang, excluding 'member')
    function isAdminStaff() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role in [
           'pengurus_kecamatan',
           'admin_keanggotaan',
           'bendahara',
           'admin_informasi',
           'pengurus_kelurahan'
         ])
      );
    }

    function isFinanceAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().role == 'bendahara')
      );
    }

    // USERS COLLECTION (Rule 1 & Rule 2: User management & Role immutability)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // ADMINS MARKER COLLECTION
    match /admins/{adminUid} {
      allow read: if isAdminStaff();
      allow write: if isSuperAdmin();
    }

    // MEMBERS COLLECTION (Direktori UMKM & Pendaftaran Mandiri)
    match /members/{memberId} {
      allow read, write: if true;
    }

    // TRANSACTIONS COLLECTION (Rule 4: STRICT ISOLATION - Financial data strictly hidden from 'member')
    match /transactions/{transactionId} {
      allow read: if isFinanceAdmin();
      allow create, update, delete: if isFinanceAdmin();
    }

    // EVENTS COLLECTION (Publik & Agenda Kegiatan)
    match /events/{eventId} {
      allow read, write: if true;
    }

    // ARTICLES COLLECTION (Publik & Kabar Berita)
    match /articles/{articleId} {
      allow read, write: if true;
    }

    // ACTIVITY LOGS (Rule 4: Audit trails protected)
    match /activity_logs/{logId} {
      allow read: if isAdminStaff();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // ORGANIZATION STRUCTURE & SETTINGS (Publik & Admin Website Profile)
    match /org_structure/{memberId} {
      allow read, write: if true;
    }

    match /org_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
